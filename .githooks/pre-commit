#!/bin/bash
# ============================================================
# Git Pre-Commit Hook — 质量门禁
# 检查 .claude/pass/ 下的标记文件是否存在且有效
# 如果标记文件不存在或过期，拒绝提交
# ============================================================

PASS_DIR=".claude/pass"
TEST_PASS="$PASS_DIR/test.pass"
QUALITY_PASS="$PASS_DIR/quality.pass"
PASSED=0

# ---------- 检查 test.pass ----------
if [ -f "$TEST_PASS" ]; then
    STATUS=$(python -c "import json; print(json.load(open('$TEST_PASS'))['status'])" 2>/dev/null)
    if [ "$STATUS" = "pass" ]; then
        echo "[OK] test.pass: 测试已通过"
        PASSED=$((PASSED + 1))
    else
        echo "[FAIL] test.pass: 标记文件状态异常 (status=$STATUS)"
    fi
else
    echo "[FAIL] test.pass: 标记文件不存在"
fi

# ---------- 检查 quality.pass ----------
if [ -f "$QUALITY_PASS" ]; then
    STATUS=$(python -c "import json; print(json.load(open('$QUALITY_PASS'))['status'])" 2>/dev/null)
    SCORE=$(python -c "import json; d=json.load(open('$QUALITY_PASS')); print(f\"{d.get('score', '?')}/100\")" 2>/dev/null)
    if [ "$STATUS" = "pass" ]; then
        echo "[OK] quality.pass: 质量检查已通过 (评分: $SCORE)"
        PASSED=$((PASSED + 1))
    else
        echo "[FAIL] quality.pass: 标记文件状态异常 (status=$STATUS)"
    fi
else
    echo "[FAIL] quality.pass: 标记文件不存在"
fi

# ---------- 最终判断 ----------
if [ "$PASSED" -eq 2 ]; then
    echo ""
    echo "========================================"
    echo "  ALL CHECKS PASSED — 允许提交"
    echo "========================================"
    exit 0
else
    echo ""
    echo "========================================"
    echo "  CHECKS FAILED — 拒绝提交"
    echo "========================================"
    echo ""
    echo "请在 Claude Code 中运行 /gitcommit 来执行质量门禁流程。"
    echo "或手动运行测试和质量检查后重试。"
    exit 1
fi
